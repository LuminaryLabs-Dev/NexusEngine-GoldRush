  "principles": [
    {
      "id": "kit-first-runtime",
      "summary": "Everything meaningful becomes a kit and installs into the NexusRealtime runtime.",
      "localGate": "tools/validation/validate-runtime-kit-registry.mjs"
    },
    {
      "id": "domain-first-composition",
      "summary": "Reusable capabilities stay neutral; GoldRush composes them through custom kits and data.",
      "localGate": "tools/validation/validate-domain-kit-contracts.mjs"
    },
    {
      "id": "renderer-boundary",
      "summary": "Domain kits expose descriptors and snapshots, while renderer adapters own DOM, Three.js, and browser surfaces.",
      "localGate": "tools/validation/validate-nexus-source-alignment.mjs"
    },
    {
      "id": "headless-proof",
      "summary": "Kit claims are proven by headless validators before public/browser proof.",
      "localGate": "npm run validate"
    },
    {
      "id": "promotion-boundary",
      "summary": "Generic incubator kits remain promotable only when neutral, deterministic, resettable, snapshot-safe, and validated.",
      "localGate": "docs/architecture/graduation-rules.md"
    }
  ],
