{
  "id": "v002-goldrush-match-orchestration",
  "version": "v0.0.2",
  "domain": "goldrush",
  "subdomain": "match-orchestration",
  "domainPath": "n:goldrush:match-orchestration",
  "apiName": "v002GoldrushMatchOrchestration",
  "kind": "composite-domain",
