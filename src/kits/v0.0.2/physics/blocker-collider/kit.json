      "command": "install-kit",
      "domainPath": "n:physics:blocker-collider",
      "upstreamSnapshots": [
        "n:physics:world"
      ]
    },
    "output": {
      "domainPath": "n:physics:blocker-collider",
      "health": "registered",
      "proofGroup": "world-physics"
